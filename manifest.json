{
    "manifest_version": 3,
    "name": "Polyteller - Polymarket Countdown & Alerts",
    "version": "1.0.1",
    "version_name": "1.0.1",
    "minimum_chrome_version": "110",
    "description": "Real-time countdowns, customizable notifications, and privacy features for Polymarket traders. Track event end times and get timely alerts.",
    "author": "polytellerapp@gmail.com",
    "permissions": ["storage", "alarms", "notifications", "tabs"],
    "host_permissions": ["https://*.polymarket.com/*"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["https://*.polymarket.com/*"],
        "js": ["privacyModeEarly.js"],
        "run_at": "document_start",
        "all_frames": true
      },
      {
        "matches": ["https://*.polymarket.com/*"],
        "js": ["content.js", "privacyMode.js"],
        "css": ["content.css"]
      }
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
      }
    },
    "icons": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "styles.css",
          "allNotifications.html",
          "https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap"
        ],
        "matches": ["https://*.polymarket.com/*"]
      }
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline';"
    },
    "privacy": {
      "message": "This extension does not collect, store, or transmit any personal data. All data is stored locally on your device and is never sent to external servers."
    },
    "data_usage": {
      "collection": false,
      "transmission": false,
      "personalization": false,
      "authentication": false
    },
    "homepage_url": "https://polyteller.com",
    "offline_enabled": true,
    "short_name": "Polyteller"
}

{
  "name": "polyteller",
  "version": "1.0.6",
  "description": "Open-source Chrome extension for Polymarket countdowns, local reminders, privacy masking, and trade confirmations",
  "license": "MIT",
  "author": "Zaid Azmi <hi@polyteller.com>",
  "homepage": "https://github.com/zaidazmi/polyteller#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaidazmi/polyteller.git"
  },
  "bugs": {
    "url": "https://github.com/zaidazmi/polyteller/issues"
  },
  "keywords": [
    "chrome-extension",
    "polymarket",
    "prediction-markets",
    "notifications",
    "privacy",
    "typescript",
    "webextension"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist/",
    "sync-version": "node -e \"const manifest=require('./manifest.json');const pkg=require('./package.json');if(pkg.version!==manifest.version){pkg.version=manifest.version;require('fs').writeFileSync('package.json',JSON.stringify(pkg,null,2))}\"",
    "dev": "npm run sync-version && npm run clean && webpack --mode development --watch",
    "build": "npm run sync-version && npm run clean && webpack --mode production",
    "build:dev": "npm run sync-version && npm run clean && webpack --mode development",
    "test": "jest"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@types/canvas-confetti": "^1.6.4",
    "@types/chrome": "^0.0.237",
    "@types/jest": "^29.5.5",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "glob": "^11.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.1",
    "postcss": "^8.4.49",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^10.1.1",
    "purgecss-webpack-plugin": "^6.0.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "dayjs": "^1.11.13",
    "zustand": "^5.0.0-rc.2"
  }
}
